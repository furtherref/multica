# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Only the web and docs workspaces (plus the root dependency patch inputs
# under apps/mobile/patches) are used by an image build. Default-exclude other
# app files so they do not silently enter the build context.
#
# apps/docs is fork-only (upstream ships no docs image): Dockerfile.docs builds
# the self-hosted docs frontend from it.
/apps/*
!/apps/web/
!/apps/docs/
!/apps/mobile
/apps/mobile/*
!/apps/mobile/patches
!/apps/mobile/patches/**

# Repository-only tooling
/.github/
/deploy/
/scripts/
